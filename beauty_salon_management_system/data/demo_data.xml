    <!-- Assign staff to salons -->
    <function model="beauty.salon.staff" name="write">
        <value eval="[ref('demo_staff_1')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_1')])]}"/>
    </function>

    <function model="beauty.salon.staff" name="write">
        <value eval="[ref('demo_staff_2')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_1')])]}"/>
    </function>

    <function model="beauty.salon.staff" name="write">
        <value eval="[ref('demo_staff_3')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_2')])]}"/>
    </function>

    <function model="beauty.salon.staff" name="write">
        <value eval="[ref('demo_staff_4')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_2')])]}"/>
    </function>

    <!-- Assign services to salons -->
    <function model="beauty.salon.service" name="write">
        <value eval="[ref('demo_service_1'), ref('demo_service_2'), ref('demo_service_3'), ref('demo_service_4')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_1')])]}"/>
    </function>

    <function model="beauty.salon.service" name="write">
        <value eval="[ref('demo_service_5'), ref('demo_service_6')]"/>
        <value eval="{'salon_ids': [(6, 0, [ref('demo_salon_2')])]}"/>
    </function>

    <!-- Assign managers to salons -->
    <function model="beauty.salon" name="write">
        <value eval="[ref('demo_salon_1')]"/>
        <value eval="{'manager_id': ref('demo_staff_1')}"/>
    </function>

    <function model="beauty.salon" name="write">
        <value eval="[ref('demo_salon_2')]"/>
        <value eval="{'manager_id': ref('demo_staff_3')}"/>
    </function>

    <!-- Assign clients to salons -->
    <function model="beauty.salon.client" name="write">
        <value eval="[ref('demo_client_1'), ref('demo_client_2')]"/>
        <value eval="{'salon_id': ref('demo_salon_1')}"/>
    </function>

    <function model="beauty.salon.client" name="write">
        <value eval="[ref('demo_client_3')]"/>
        <value eval="{'salon_id': ref('demo_salon_2')}"/>
    </function>

    <!-- Create demo appointments -->
