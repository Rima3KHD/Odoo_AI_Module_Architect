        <field name="client_id" ref="demo_client_1"/>
        <field name="service_id" ref="demo_service_1"/>
        <field name="staff_id" ref="demo_staff_1"/>
        <field name="appointment_date" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
        <field name="duration">60</field>
        <field name="state">confirmed</field>
        <field name="notes">Client requested extra volume styling. Please prepare volumizing products.</field>
    </record>

